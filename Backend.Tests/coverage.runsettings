<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>lcov,cobertura,opencover</Format>
          <Exclude>[*.Tests]*</Exclude>
          <!-- Exclude generated OpenAPI and other generated files that skew coverage -->
          <ExcludeByFile>**/Microsoft.AspNetCore.OpenApi.Generated.*;**/*OpenApi*.cs;**/*.g.cs;**/Generated/*</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
